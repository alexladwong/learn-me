# ---- Capacitor native builds -------------------------------------------------
# Generated by `npx cap add`, and regenerated by `npx cap sync`. The native
# projects themselves ARE committed (they carry the URL scheme, the manifest and
# the store metadata); only their build output is not.
android/.gradle/
android/build/
android/app/build/
android/local.properties
android/app/src/main/assets/public/
ios/App/build/
ios/App/DerivedData/
ios/App/App/public/
ios/App/App/capacitor.config.json
ios/App/Pods/
ios/App/App.xcworkspace/xcuserdata/
ios/App/App.xcodeproj/xcuserdata/
